#include <stdio.h>
#include <stdint.h>
#include <omp.h>
 
#define N 13216000ULL
#define MOD 1000000007ULL
 
static inline uint32_t collatz_steps(uint64_t n) {
    uint32_t steps = 0;
    while (n > 1) {
        if ((n & 1) == 0) {
            n >>= 1;
        } else {
            n = 3 * n + 1;
        }
        steps++;
    }
    return steps;
}
 
/* One full pass over [1, N]. Returns max steps via out param,
 * checksum via return value. */
static uint64_t run_pass(uint32_t *max_steps_out) {
    uint32_t max_steps = 0;
    uint64_t checksum = 0;
 
    for (uint64_t i = 1; i <= N; i++) {
        uint32_t steps = collatz_steps(i);
        if (steps > max_steps) {
            max_steps = steps;
        }
        checksum = (checksum + steps) % MOD;
    }
 
    *max_steps_out = max_steps;
    return checksum;
}
 
int main(void) {
    printf("=== Sequential Collatz Baseline ===\n");
    printf("N = %llu\n\n", (unsigned long long)N);
 
    double times[3];
    uint32_t max_steps = 0;
    uint64_t checksum = 0;
 
    for (int run = 0; run < 3; run++) {
        double t0 = omp_get_wtime();
        checksum = run_pass(&max_steps);
        double t1 = omp_get_wtime();
        times[run] = t1 - t0;
 
        printf("Run %d: %.6f s  (max_steps=%u, checksum=%llu)%s\n",
               run + 1, times[run], max_steps,
               (unsigned long long)checksum,
               run == 0 ? "  <-- warm-up, discard" : "");
    }
 
    double t_seq = (times[1] + times[2]) / 2.0;
 
    printf("\n--- Summary ---\n");
    printf("Max stopping time observed : %u\n", max_steps);
    printf("Checksum (sum mod 1e9+7)   : %llu\n", (unsigned long long)checksum);
    printf("T_seq = (Run2 + Run3) / 2  : %.6f s\n", t_seq);
 
    return 0;
}
 


