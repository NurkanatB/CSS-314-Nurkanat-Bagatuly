#include <stdint.h>
#include <omp.h>
 
#define N 13216000ULL
#define MOD 1000000007ULL
#define EXPECTED_CHECKSUM 90294763ULL
#define EXPECTED_MAX_STEPS 688u
 
static inline uint32_t collatz_steps(uint64_t n) {
    uint32_t steps = 0;
    while (n > 1) {
        if ((n & 1) == 0) {
            n >>= 1;
        } else {
            n = 3 * n + 1;
        }
        steps++;
    }
    return steps;
}
 
/* One full parallel pass over [1, N] using `threads` OpenMP threads.
 * Returns checksum, writes max steps via out param. */
static uint64_t run_pass(int threads, uint32_t *max_steps_out) {
    uint32_t max_steps = 0;
    uint64_t checksum = 0;
 
    #pragma omp parallel for num_threads(threads) schedule(static) \
        reduction(max:max_steps) reduction(+:checksum)
    for (uint64_t i = 1; i <= N; i++) {
        uint32_t steps = collatz_steps(i);
        if (steps > max_steps) {
            max_steps = steps;
        }
        checksum = (checksum + steps) % MOD;
    }
 
    /* IMPORTANT: reduction(+:checksum) sums each thread's already-modded
     * partial checksum across threads, but does NOT re-apply % MOD to
     * the combined result. Without this line, checksum can come out as
     * (true_checksum + j*MOD) for some small j = 0..(threads-1),
     * which is why raw values differed across thread counts. */
    checksum %= MOD;
 
    *max_steps_out = max_steps;
    return checksum;
}
 
int main(int argc, char **argv) {
    if (argc != 2) {
        fprintf(stderr, "Usage: %s <num_threads>\n", argv[0]);
        return 1;
    }
    int threads = atoi(argv[1]);
    if (threads < 1) {
        fprintf(stderr, "Thread count must be >= 1\n");
        return 1;
    }
 
    printf("=== Parallel Collatz Scaling (k = %d threads) ===\n", threads);
    printf("N = %llu\n\n", (unsigned long long)N);
 
    double times[3];
    uint32_t max_steps = 0;
    uint64_t checksum = 0;
 
    for (int run = 0; run < 3; run++) {
        double t0 = omp_get_wtime();
        checksum = run_pass(threads, &max_steps);
        double t1 = omp_get_wtime();
        times[run] = t1 - t0;
 
        printf("Run %d: %.6f s  (max_steps=%u, checksum=%llu)%s\n",
               run + 1, times[run], max_steps,
               (unsigned long long)checksum,
               run == 0 ? "  <-- warm-up, discard" : "");
    }
 
    double t_k = (times[1] + times[2]) / 2.0;
 
    printf("\n--- Summary (k = %d) ---\n", threads);
    printf("Max stopping time observed : %u\n", max_steps);
    printf("Checksum (sum mod 1e9+7)   : %llu\n", (unsigned long long)checksum);
    printf("T_%d = (Run2 + Run3) / 2   : %.6f s\n", threads, t_k);
 
    if (checksum != EXPECTED_CHECKSUM || max_steps != EXPECTED_MAX_STEPS) {
        printf("\n[WARNING] Checksum/max_steps do NOT match the sequential "
               "baseline (expected checksum=%llu, max_steps=%u). "
               "Something is wrong with the parallel reduction.\n",
               (unsigned long long)EXPECTED_CHECKSUM, EXPECTED_MAX_STEPS);
    } else {
        printf("\n[OK] Checksum and max_steps match sequential baseline.\n");
    }
 
    return 0;
}


