#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <omp.h>

#define N 13216000ULL
#define THRESHOLD 100
#define MAX_THREADS 64

static inline uint32_t collatz_steps(uint64_t n) {
    uint32_t steps = 0;
    while (n > 1) {
        if ((n & 1) == 0) {
            n >>= 1;
        } else {
            n = 3 * n + 1;
        }
        steps++;
    }
    return steps;
}

/* ---- Variant 1: naive per-thread array, adjacent elements share a
 * 64-byte cache line -> false sharing under MESI protocol. ---- */
static uint64_t naive_pass(int threads) {
    static int hit_count[MAX_THREADS]; /* NOT padded: triggers false sharing */
    memset(hit_count, 0, sizeof(hit_count));

    #pragma omp parallel for num_threads(threads) schedule(static)
    for (uint64_t i = 1; i <= N; i++) {
        if (collatz_steps(i) > THRESHOLD) {
            hit_count[omp_get_thread_num()]++;
        }
    }

    uint64_t total = 0;
    for (int t = 0; t < threads; t++) total += hit_count[t];
    return total;
}

/* ---- Variant 2: OpenMP reduction, no shared mutable array at all. ---- */
static uint64_t reduction_pass(int threads) {
    uint64_t total_hits = 0;

    #pragma omp parallel for num_threads(threads) schedule(static) \
        reduction(+:total_hits)
    for (uint64_t i = 1; i <= N; i++) {
        if (collatz_steps(i) > THRESHOLD) {
            total_hits++;
        }
    }
    return total_hits;
}

static void run_and_report(const char *label, uint64_t (*pass_fn)(int),
                            int threads) {
    printf("=== Experiment A: %s (threads=%d) ===\n", label, threads);

    double times[3];
    uint64_t total = 0;

    for (int run = 0; run < 3; run++) {
        double t0 = omp_get_wtime();
        total = pass_fn(threads);
        double t1 = omp_get_wtime();
        times[run] = t1 - t0;
        printf("Run %d: %.6f s  (hits=%llu)%s\n",
               run + 1, times[run], (unsigned long long)total,
               run == 0 ? "  <-- warm-up, discard" : "");
    }

    double avg = (times[1] + times[2]) / 2.0;
    double throughput = (double)N / avg;

    printf("\n--- Summary: %s ---\n", label);
    printf("Total hits (steps > %d)     : %llu\n", THRESHOLD,
           (unsigned long long)total);
    printf("Avg execution time          : %.6f s\n", avg);
    printf("Effective throughput        : %.2f iter/sec\n\n", throughput);
}

int main(int argc, char **argv) {
    if (argc != 3) {
        fprintf(stderr, "Usage: %s <naive|padded> <num_threads>\n", argv[0]);
        return 1;
    }
    int threads = atoi(argv[2]);
    if (threads < 1 || threads > MAX_THREADS) {
        fprintf(stderr, "Thread count must be 1..%d\n", MAX_THREADS);
        return 1;
    }

    if (strcmp(argv[1], "naive") == 0) {
        run_and_report("Variant 1: Naive hits[tid]++ (False Sharing)",
                        naive_pass, threads);
    } else if (strcmp(argv[1], "padded") == 0) {
        run_and_report("Variant 2: Reduction (Mitigated)",
                        reduction_pass, threads);
    } else {
        fprintf(stderr, "First argument must be 'naive' or 'padded'\n");
        return 1;
    }

    return 0;
}


