/* One pass, schedule kind selected by a small integer code so we can
 * keep a single function body (OpenMP schedule clauses can't easily
 * be parameterized at runtime without the schedule(runtime) clause). */
static uint64_t run_pass(int threads, int schedule_code, uint32_t *max_out) {
    uint32_t max_steps = 0;
    uint64_t checksum = 0;

    switch (schedule_code) {
    case 0: /* static, default chunk */
        #pragma omp parallel for num_threads(threads) schedule(static) \
            reduction(max:max_steps) reduction(+:checksum)
        for (uint64_t i = 1; i <= N; i++) {
            uint32_t s = collatz_steps(i);
            if (s > max_steps) max_steps = s;
            checksum = (checksum + s) % MOD;
        }
        break;
    case 1: /* static, chunk=1000 */
        #pragma omp parallel for num_threads(threads) schedule(static, 1000) \
            reduction(max:max_steps) reduction(+:checksum)
        for (uint64_t i = 1; i <= N; i++) {
            uint32_t s = collatz_steps(i);
            if (s > max_steps) max_steps = s;
            checksum = (checksum + s) % MOD;
        }
        break;
    case 2: /* dynamic, chunk=100 */
        #pragma omp parallel for num_threads(threads) schedule(dynamic, 100) \
            reduction(max:max_steps) reduction(+:checksum)
        for (uint64_t i = 1; i <= N; i++) {
            uint32_t s = collatz_steps(i);
            if (s > max_steps) max_steps = s;
            checksum = (checksum + s) % MOD;
        }
        break;
    case 3: /* dynamic, chunk=10000 */
        #pragma omp parallel for num_threads(threads) schedule(dynamic, 10000) \
            reduction(max:max_steps) reduction(+:checksum)
        for (uint64_t i = 1; i <= N; i++) {
            uint32_t s = collatz_steps(i);
            if (s > max_steps) max_steps = s;
            checksum = (checksum + s) % MOD;
        }
        break;
    case 4: /* guided */
        #pragma omp parallel for num_threads(threads) schedule(guided) \
            reduction(max:max_steps) reduction(+:checksum)
        for (uint64_t i = 1; i <= N; i++) {
            uint32_t s = collatz_steps(i);
            if (s > max_steps) max_steps = s;
            checksum = (checksum + s) % MOD;
        }
        break;
    }

    checksum %= MOD; /* combine-step fix, see collatz_par.c note */
    *max_out = max_steps;
    return checksum;
}

