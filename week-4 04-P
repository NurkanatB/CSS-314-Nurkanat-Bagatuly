import threading
import time
import math
from concurrent.futures import ThreadPoolExecutor

def worker_task(thread_id: int, team_size: int, heavy: bool = False):
    native_tid = threading.get_native_id()
    role = "Master" if thread_id == 0 else "Worker"
    if heavy:
        total = 0.0
        for _ in range(2_000_000):
            total += math.sqrt(total + 1)
    else:
        time.sleep(0.001 * (thread_id % 3))
    print(f"[{role}] Rank: {thread_id} of {team_size} | TID: {native_tid}")

def run_team(num_threads: int, heavy: bool = False):
    with ThreadPoolExecutor(max_workers=num_threads) as executor:
        futures = [executor.submit(worker_task, tid, num_threads, heavy) for tid in range(num_threads)]
        for f in futures:
            f.result()

def task_1_1():
    print("=== TASK 1.1: non-determinism ===")
    with open("run_log.txt", "w") as log:
        import sys
        for i in range(10):
            log.write(f"--- run {i+1} ---\n")
            from io import StringIO
            buf = StringIO()
            old_stdout = sys.stdout
            sys.stdout = buf
            run_team(4)
            sys.stdout = old_stdout
            log.write(buf.getvalue())
    print("Готово. Результаты в run_log.txt")

def task_1_2():
    print("=== TASK 1.2: oversubscription sweep ===")
    results = {}
    for P in [1, 2, 4, 8, 16, 32, 64]:
        t0 = time.perf_counter()
        run_team(P)
        t1 = time.perf_counter()
        results[P] = t1 - t0
    with open("task1_2_results.csv", "w") as f:
        f.write("P,time_sec\n")
        for P, t in results.items():
            f.write(f"{P},{t:.6f}\n")
            print(f"P={P}: {t:.6f} s")
    print("Готово. Результаты в task1_2_results.csv")

def task_1_3():
    print("=== TASK 1.3: CPU saturation (следи за монитором ресурсов!) ===")
    run_team(4, heavy=True)
    print("Готово.")

if __name__ == "__main__":
    task_1_1()
    task_1_2()
    task_1_3()



